# Hermes Agent on iMessage through Photon.
# Copy this file to .env for a local Docker run. On Railway, set the same
# names as service variables. Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Photon (required)
# ---------------------------------------------------------------------------

# Your Photon project id. Copy it from your project in the Photon dashboard,
# https://app.photon.codes. The Photon deploy flow sets it for you.
PHOTON_PROJECT_ID=

# The secret (API key) for that project, from the same place. The dashboard
# shows a secret only once, so store it somewhere safe. Treat it like a
# password.
PHOTON_PROJECT_SECRET=

# ---------------------------------------------------------------------------
# Photon (optional)
# ---------------------------------------------------------------------------

# Phone numbers that may talk to the agent, in E.164 format, separated by
# commas. Example: +15551234567,+15559876543
# Set it to the number you confirmed in the Photon dashboard. When it is
# empty, an unknown sender gets a pairing code instead of a reply, and you
# approve the code from a shell in the container:
#   hermes pairing approve photon <CODE>
PHOTON_ALLOWED_USERS=

# Loopback port for the Photon Node sidecar inside the container. Nothing
# outside the container connects to it. Change it only if 8789 is taken.
# PHOTON_SIDECAR_PORT=8789

# ---------------------------------------------------------------------------
# Model (required)
# ---------------------------------------------------------------------------

# OpenRouter API key. Create one at https://openrouter.ai/settings/keys
# OpenRouter charges for the tokens the agent uses.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Model (optional)
# ---------------------------------------------------------------------------

# OpenRouter model id, as listed at https://openrouter.ai/models
# Defaults to z-ai/glm-5.2, the OpenRouter default of the pinned Hermes
# Agent release. The model must support tool calling.
# HERMES_MODEL=z-ai/glm-5.2
