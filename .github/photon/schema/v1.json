{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photon.codes/schema/template/v1.json",
  "title": "Photon template manifest",
  "description": "photon.jsonc, spec version 1: what a template needs from Photon, what the person deploying it fills in, and where it can run. Structure only; the rules a schema can't express (dates, collisions, secrets) are in the spec and the reference checker.",
  "oneOf": [{ "$ref": "#/$defs/template" }, { "$ref": "#/$defs/workspace" }],
  "$defs": {
    "template": {
      "type": "object",
      "required": [
        "specVersion",
        "compatibilityDate",
        "name",
        "version",
        "title",
        "description",
        "channels",
        "delivery",
        "hosts"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "specVersion": { "$ref": "#/$defs/specVersion" },
        "compatibilityDate": { "$ref": "#/$defs/compatibilityDate" },
        "compatibilityFlags": { "$ref": "#/$defs/compatibilityFlags" },
        "kind": { "const": "template", "default": "template" },
        "name": {
          "description": "The template's id in the catalog and in /project/new?template=. Unique across Photon's catalog.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 63
        },
        "version": {
          "description": "The template's own version (semver). A major bump means an existing deployment can't take the new version without the person's action.",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "icon": {
          "description": "A PNG or SVG inside the template's directory, relative to this file.",
          "type": "string",
          "pattern": "^\\./(?!.*\\.\\.)[^\\s]+\\.(png|svg)$"
        },
        "categories": {
          "description": "Open list: values Photon doesn't recognize are kept and shown as tags.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32 },
          "maxItems": 5,
          "uniqueItems": true
        },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "url": { "$ref": "#/$defs/httpsUrl" },
            "email": { "type": "string", "format": "email" }
          },
          "additionalProperties": false
        },
        "license": { "description": "SPDX identifier.", "type": "string", "maxLength": 64 },
        "links": {
          "type": "object",
          "properties": {
            "docs": { "$ref": "#/$defs/link" },
            "source": { "$ref": "#/$defs/httpsUrl" },
            "support": { "$ref": "#/$defs/link" }
          },
          "patternProperties": { "^x-": true },
          "additionalProperties": false
        },
        "demo": {
          "description": "An agent already running from this template, to try before deploying: an address per channel.",
          "type": "object",
          "properties": { "imessage": { "$ref": "#/$defs/phone" } },
          "additionalProperties": false
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/channel" }
        },
        "delivery": { "$ref": "#/$defs/delivery" },
        "bindings": {
          "description": "Values Photon provides, under the environment variable names the template's code already reads.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": { "$ref": "#/$defs/binding" },
          "maxProperties": 32
        },
        "vars": {
          "description": "Values the person deploying fills in, or Photon generates.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": { "$ref": "#/$defs/var" },
          "maxProperties": 32
        },
        "hosts": { "$ref": "#/$defs/hosts" },
        "defaultHost": { "$ref": "#/$defs/hostId" },
        "checks": { "$ref": "#/$defs/checks" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "workspace": {
      "description": "A repository holding several templates, each in its own directory with its own photon.jsonc.",
      "type": "object",
      "required": ["specVersion", "compatibilityDate", "kind", "templates"],
      "properties": {
        "$schema": { "type": "string" },
        "specVersion": { "$ref": "#/$defs/specVersion" },
        "compatibilityDate": { "$ref": "#/$defs/compatibilityDate" },
        "kind": { "const": "workspace" },
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "description": "A directory relative to this file; a trailing /* takes every directory under it.",
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+(/\\*)?$"
          },
          "uniqueItems": true
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "specVersion": {
      "description": "The manifest format's major version. This schema is version 1.",
      "const": 1
    },
    "compatibilityDate": {
      "description": "The date whose Photon behavior this template was written against. Photon keeps that behavior for it until the date moves.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "compatibilityFlags": {
      "description": "Opt into a behavior before its date, or keep one past it (no_<flag>).",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
      "uniqueItems": true,
      "maxItems": 32
    },

    "envName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "link": {
      "description": "An https URL, or a path inside the template's directory with an optional #anchor.",
      "type": "string",
      "pattern": "^(https://\\S+|\\./(?!.*\\.\\.)[^\\s#]+(#[A-Za-z0-9_-]+)?)$"
    },
    "phone": { "type": "string", "pattern": "^\\+[1-9]\\d{6,14}$" },

    "channel": {
      "oneOf": [{ "$ref": "#/$defs/channelImessage" }]
    },
    "channelImessage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "imessage" },
        "lines": {
          "description": "Which kinds of iMessage line the template works on; the setup offers these.",
          "type": "array",
          "items": { "enum": ["shared", "dedicated"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["shared", "dedicated"]
        },
        "defaultLine": { "enum": ["shared", "dedicated"], "default": "shared" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "delivery": {
      "description": "How messages reach the agent.",
      "oneOf": [{ "$ref": "#/$defs/deliveryWebhook" }, { "$ref": "#/$defs/deliveryStream" }]
    },
    "deliveryWebhook": {
      "type": "object",
      "required": ["type", "path", "signature"],
      "properties": {
        "type": { "const": "webhook" },
        "path": {
          "description": "Where on the deployment Photon POSTs messages.",
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~/-]*$",
          "maxLength": 256
        },
        "events": {
          "type": "array",
          "items": { "enum": ["message.received"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["message.received"]
        },
        "signature": {
          "description": "The signing scheme the template's code verifies.",
          "enum": ["spectrum-v0", "standard-webhooks"]
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "deliveryStream": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "stream", "description": "The agent holds a connection open to Photon; no public address needed." }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "bindingSource": {
      "enum": [
        "photon.project.id",
        "photon.project.secret",
        "photon.api.url",
        "photon.webhook.secret",
        "photon.owner.phones",
        "photon.line.number",
        "photon.deployment.id"
      ]
    },
    "binding": {
      "oneOf": [
        { "$ref": "#/$defs/bindingSource" },
        {
          "type": "object",
          "required": ["from"],
          "properties": {
            "from": { "$ref": "#/$defs/bindingSource" },
            "format": {
              "description": "How a list is written: comma-separated (csv) or a JSON array.",
              "enum": ["csv", "json"],
              "default": "csv"
            }
          },
          "patternProperties": { "^x-": true },
          "additionalProperties": false
        }
      ]
    },

    "var": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "type": {
          "enum": ["string", "secret", "url", "email", "phone", "enum", "boolean", "integer"],
          "default": "string"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 280 },
        "link": { "$ref": "#/$defs/httpsUrl", "description": "Where to get the value." },
        "required": {
          "description": "Defaults to true, unless the variable has a default or is generated.",
          "type": "boolean"
        },
        "default": { "type": ["string", "boolean", "integer"] },
        "placeholder": { "type": "string", "maxLength": 128 },
        "pattern": { "type": "string", "maxLength": 256, "format": "regex" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string", "maxLength": 64 }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "advanced": {
          "description": "Shown folded away, under the required ones.",
          "type": "boolean",
          "default": false
        },
        "generate": {
          "description": "Photon fills it in with a fresh random value; the person never sees it.",
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "random" },
            "bytes": { "type": "integer", "minimum": 16, "maximum": 64, "default": 32 },
            "encoding": { "enum": ["hex", "base64url"], "default": "hex" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "secret" } }, "required": ["type"] },
          "then": { "not": { "required": ["default"] } }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["options"] }
        },
        {
          "if": { "required": ["generate"] },
          "then": {
            "properties": { "type": { "const": "secret" } },
            "required": ["type"],
            "not": { "anyOf": [{ "required": ["default"] }, { "required": ["placeholder"] }] }
          }
        }
      ],
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "hostId": { "enum": ["vercel", "railway", "docker", "source"] },
    "hosts": {
      "description": "Where the template can run. Each block is read only by its own host's adapter.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "vercel": { "$ref": "#/$defs/hostVercel" },
        "railway": { "$ref": "#/$defs/hostRailway" },
        "docker": { "$ref": "#/$defs/hostDocker" },
        "source": { "$ref": "#/$defs/hostSource" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "hostVercel": {
      "type": "object",
      "properties": {
        "rootDirectory": { "$ref": "#/$defs/relativeDir" },
        "environments": {
          "description": "The Vercel environments Photon writes its bindings to.",
          "type": "array",
          "items": { "enum": ["production", "preview", "development"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["production"]
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "hostRailway": {
      "type": "object",
      "properties": {
        "rootDirectory": { "$ref": "#/$defs/relativeDir" },
        "build": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "const": "dockerfile" },
                "path": { "type": "string", "default": "Dockerfile" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "image"],
              "properties": {
                "type": { "const": "image" },
                "image": {
                  "description": "Pinned by digest.",
                  "type": "string",
                  "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "start": { "type": "string", "maxLength": 512 },
        "volumes": { "$ref": "#/$defs/volumes" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
        "restartPolicy": { "enum": ["on-failure", "always", "never"], "default": "on-failure" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "hostDocker": {
      "description": "Run it yourself as a container.",
      "type": "object",
      "properties": {
        "dockerfile": { "type": "string", "default": "Dockerfile" },
        "image": { "type": "string" },
        "volumes": { "$ref": "#/$defs/volumes" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "hostSource": {
      "description": "Run it yourself from the code: Photon hands over the values as an env file.",
      "type": "object",
      "properties": {
        "guide": { "$ref": "#/$defs/link" },
        "envFile": { "type": "string", "pattern": "^\\.?[A-Za-z0-9._-]+$", "default": ".env" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "relativeDir": {
      "type": "string",
      "pattern": "^\\.(/(?!.*\\.\\.)[A-Za-z0-9._-]+)*$",
      "default": "."
    },
    "volumes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["mountPath"],
        "properties": {
          "mountPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
          "sizeMB": { "type": "integer", "minimum": 128 }
        },
        "additionalProperties": false
      }
    },

    "checks": {
      "type": "object",
      "properties": {
        "online": {
          "description": "When the setup calls the agent online. Defaults to delivery: the webhook answers, or the stream is connected.",
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": { "type": { "const": "delivery" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "path"],
              "properties": {
                "type": { "const": "http" },
                "path": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$" },
                "status": { "type": "integer", "minimum": 200, "maximum": 299, "default": 200 }
              },
              "additionalProperties": false
            }
          ]
        },
        "done": {
          "description": "What the last step waits for. Defaults to the agent's first reply on the first channel.",
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "first-reply" },
            "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 600 }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    }
  }
}
